# Воркспейс — не репозиторий, а способ держать репозитории рядом
# на машине разработчика. Каждый пакет имеет свой .gitignore.
.DS_Store
.attic/

# Репозитории команд — их поднимает Tools/bootstrap.sh.
# Игнорируем папку целиком: теперь она сама репозиторий, а не контейнер
# для двадцати одного вложенного.
*_team/

# Промежуточные копии переезда в репозитории команд
.migrate/

# Зависимости реестра. Восстанавливаются из package-lock.json одной командой
# (cd registry && npm ci) — версии там зафиксированы точно, поэтому хранить
# сами файлы незачем: 393 МБ и девять тысяч файлов ради того, что и так
# воспроизводится. Правило пишется без пути специально: сработает и для
# node_modules на любом другом уровне, если он когда-нибудь появится.
node_modules/

# Состояние окна воркспейса
KufarWorkspace.xcworkspace/xcuserdata/

# Байткод инструментов из Tools/. Появляется при первом же запуске
# deplint.py или gen-graph.py и не несёт информации.
__pycache__/
